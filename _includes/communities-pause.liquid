{% assign groups = "" | split: ',' %}

{% capture groups_data %}
Amagasaki.rb|http://kokucheese.com/main/tag/amagasakirb/|/assets/img/rubyhexagon.png|2009年 〜 2014年|
Cherry.rb|https://cherryrb.doorkeeper.jp/|https://dzpp79ucibp5a.cloudfront.net/groups_logos/6514_normal_1475125227_cherryrb_2.png|2015年 〜 2018年|
DDD.rb|https://dddrb.doorkeeper.jp/|/assets/img/dddrb.png|2015年 〜 2018年|naniwa.rb に名前を変更
Hommachi.rb|https://hommachirb.doorkeeper.jp/|https://dzpp79ucibp5a.cloudfront.net/groups_logos/3505_normal_1405996867_rogo.png|2014年 〜 2015年|
Medaka.rb|https://medakarb.doorkeeper.jp/|https://dzpp79ucibp5a.cloudfront.net/groups_logos/4030_normal_1440816854_02b_b_red.png|2014年 〜 2016年|
Minami.rb|http://qwik.jp/minamirb/|/assets/img/rubyhexagon.png|2009年 〜 2015年|
西脇.rb & 神戸.rb|https://nishiwaki-koberb.doorkeeper.jp/|https://dzpp79ucibp5a.cloudfront.net/groups_logos/1145_normal_1371633191_nshgrb-doorkeeper.jpeg|2013年 〜 2019年|
{% endcapture %}

{% assign groups_array = groups_data | strip | split: '
' %}

<div class="row">
  <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <h2>コミュニティー (休止)</h2>
  </div>

  {% for group_line in groups_array %}
    {% assign group = group_line | split: '|' %}
    <div class="col-lg-6">
      <div class="well col-lg-12">
        <div class="group-logo col-lg-3">
          <a class="group-link" href="{{ group[1] }}">
            <img class="group-img img-responsive" src="{% if group[2] contains 'http' %}{{ group[2] }}{% else %}{{ site.baseurl }}{{ group[2] }}{% endif %}">
          </a>
        </div>
        <div class="col-lg-9">
          <p class="group-name">
            <a href="{{ group[1] }}">{{ group[0] }}</a>
          </p>
          <p>
            {{ group[3] }}
            {% if group[4] %}
              <br>&emsp;{{ group[4] }}
            {% endif %}
          </p>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
