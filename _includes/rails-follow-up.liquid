{% assign groups = "" | split: ',' %}

{% capture groups_data %}
Rails Follow-up Kobe|https://rails-followup-kobe.doorkeeper.jp/|/assets/img/rubyhexagon.png|2015年 〜|
Rails Follow-up Kyoto|https://rails-follow-up-kyoto.doorkeeper.jp/|/assets/img/rubyhexagon.png|2019年 〜|
Rails Follow-up Osaka|https://rails-follow-up-osaka.doorkeeper.jp/|/assets/img/rubyhexagon.png|2016年 〜|
{% endcapture %}

{% assign groups_array = groups_data | strip | split: '
' %}

<div class="row">
  <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <h2>Rails Follow-up</h2>
  </div>

  {% for group_line in groups_array %}
    {% assign group = group_line | split: '|' %}
    <div class="col-lg-6">
      <div class="well col-lg-12">
        <div class="group-logo col-lg-3">
          <a class="group-link" href="{{ group[1] }}">
            <img class="group-img img-responsive" src="{% if group[2] contains 'http' %}{{ group[2] }}{% else %}{{ site.baseurl }}{{ group[2] }}{% endif %}">
          </a>
        </div>
        <div class="col-lg-9">
          <p class="group-name">
            <a href="{{ group[1] }}">{{ group[0] }}</a>
          </p>
          <p>
            {{ group[3] }}
            {% if group[4] %}
              <br>&emsp;{{ group[4] }}
            {% endif %}
          </p>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
